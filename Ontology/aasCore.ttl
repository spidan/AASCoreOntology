@prefix : <http://www.example.org/twinMap/AASCore/> .
@prefix aas: <https://admin-shell.io/aas/3/0/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.org/twinMap/AASCore/> .

<http://www.example.org/twinMap/AASCore> rdf:type owl:Ontology ;
                                          owl:imports <https://admin-shell.io/aas/3/1/> .

#################################################################
#    Object Properties
#################################################################

###  http://www.example.org/twinMap/AASCore/ParameterProperty
:ParameterProperty rdf:type owl:ObjectProperty .


###  http://www.example.org/twinMap/AASCore/SkillProperty
:SkillProperty rdf:type owl:ObjectProperty .


###  http://www.example.org/twinMap/AASCore/hasDirection
:hasDirection rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :ParameterProperty .


###  http://www.example.org/twinMap/AASCore/hasMode
:hasMode rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :SkillProperty ;
         rdfs:range :Mode .


###  http://www.example.org/twinMap/AASCore/hasParameter
:hasParameter rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :SkillProperty ;
              rdfs:range :Parameter .


###  http://www.example.org/twinMap/AASCore/hasSubmodelElement
:hasSubmodelElement rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :modeledIn ;
                    rdfs:domain :Submodel ;
                    rdfs:range :SubmodelElement .


###  http://www.example.org/twinMap/AASCore/hasType
:hasType rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :ParameterProperty .


###  http://www.example.org/twinMap/AASCore/hasValue
:hasValue rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :ParameterProperty .


###  http://www.example.org/twinMap/AASCore/isDisabled
:isDisabled rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :SkillProperty ;
            rdfs:domain :Skill .


###  http://www.example.org/twinMap/AASCore/modeledIn
:modeledIn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain owl:Thing ;
           rdfs:range :AASSpecification .


###  http://www.example.org/twinMap/AASCore/referencedBy
:referencedBy rdf:type owl:ObjectProperty ;
              owl:inverseOf :references ;
              rdfs:domain <https://admin-shell.io/aas/3/1/HasDataSpecification> ;
              rdfs:range :AASSpecification .


###  http://www.example.org/twinMap/AASCore/references
:references rdf:type owl:ObjectProperty ;
            rdfs:domain :AASSpecification ;
            rdfs:range <https://admin-shell.io/aas/3/1/HasDataSpecification> .


###  http://www.example.org/twinMap/AASCore/semanticallyDefines
:semanticallyDefines rdf:type owl:ObjectProperty ;
                     rdfs:domain owl:Thing ;
                     rdfs:range :ReferenceElement ;
                     rdfs:comment "Property connecting a semanticID ReferenceElement to an entry in a semanticID ReferenceList" .


###  http://www.example.org/twinMap/AASCore/uses
:uses rdf:type owl:ObjectProperty ;
      rdfs:subPropertyOf :SkillProperty ;
      rdfs:range :Skill .


#################################################################
#    Data properties
#################################################################

###  http://www.example.org/twinMap/AASCore/ParameterProperty
:ParameterProperty rdf:type owl:DatatypeProperty .


###  http://www.example.org/twinMap/AASCore/SkillProperty
:SkillProperty rdf:type owl:DatatypeProperty .


###  http://www.example.org/twinMap/AASCore/hasDirection
:hasDirection rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string .


###  http://www.example.org/twinMap/AASCore/hasSemanticId
:hasSemanticId rdf:type owl:DatatypeProperty ;
               rdfs:domain :AASSpecification ;
               rdfs:range xsd:anyURI .


###  http://www.example.org/twinMap/AASCore/hasType
:hasType rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string .


###  http://www.example.org/twinMap/AASCore/isDisabled
:isDisabled rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://www.example.org/twinMap/AASCore/AASSpecification
:AASSpecification rdf:type owl:Class ;
                  rdfs:comment "Superclass for every concept that is part of an officially released AAS Spec" .


###  http://www.example.org/twinMap/AASCore/AllowedPersonalLimitations
:AllowedPersonalLimitations rdf:type owl:Class ;
                            rdfs:subClassOf :SubmodelElementList .


###  http://www.example.org/twinMap/AASCore/AssetInterfaceDescription
:AssetInterfaceDescription rdf:type owl:Class ;
                           rdfs:subClassOf :Submodel .


###  http://www.example.org/twinMap/AASCore/ControlComponentInstance
:ControlComponentInstance rdf:type owl:Class ;
                          rdfs:subClassOf :Submodel .


###  http://www.example.org/twinMap/AASCore/DigitalNameplateForIndustrialEquipment
:DigitalNameplateForIndustrialEquipment rdf:type owl:Class ;
                                        rdfs:subClassOf :Submodel .


###  http://www.example.org/twinMap/AASCore/Endpoint
:Endpoint rdf:type owl:Class ;
          rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/EndpointMetadata
:EndpointMetadata rdf:type owl:Class ;
                  rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/ErgonomicWorkstationProfile
:ErgonomicWorkstationProfile rdf:type owl:Class ;
                             rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/GeneralSkillDemand
:GeneralSkillDemand rdf:type owl:Class ;
                    rdfs:subClassOf :SubmodelElementList .


###  http://www.example.org/twinMap/AASCore/GeneralWorkstationData
:GeneralWorkstationData rdf:type owl:Class ;
                        rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/InteractionMetadata
:InteractionMetadata rdf:type owl:Class ;
                     rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/Interface
:Interface rdf:type owl:Class ;
           rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/Mode
:Mode rdf:type owl:Class ;
      rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/Operation
:Operation rdf:type owl:Class ;
           rdfs:subClassOf :SubmodelElement .


###  http://www.example.org/twinMap/AASCore/Parameter
:Parameter rdf:type owl:Class ;
           rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/ReferenceElement
:ReferenceElement rdf:type owl:Class ;
                  rdfs:subClassOf :SubmodelElement .


###  http://www.example.org/twinMap/AASCore/Skill
:Skill rdf:type owl:Class ;
       rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/Submodel
:Submodel rdf:type owl:Class ;
          rdfs:subClassOf :AASSpecification ;
          rdfs:comment "AAS Submodel according to Specification" .


###  http://www.example.org/twinMap/AASCore/SubmodelElement
:SubmodelElement rdf:type owl:Class ;
                 rdfs:subClassOf :AASSpecification .


###  http://www.example.org/twinMap/AASCore/SubmodelElementCollection
:SubmodelElementCollection rdf:type owl:Class ;
                           rdfs:subClassOf :SubmodelElement .


###  http://www.example.org/twinMap/AASCore/SubmodelElementList
:SubmodelElementList rdf:type owl:Class ;
                     rdfs:subClassOf :SubmodelElement .


###  http://www.example.org/twinMap/AASCore/Value
:Value rdf:type owl:Class ;
       rdfs:subClassOf :SubmodelElementCollection .


###  http://www.example.org/twinMap/AASCore/WorkstationWorkerMatchingData
:WorkstationWorkerMatchingData rdf:type owl:Class ;
                               rdfs:subClassOf :Submodel .


###  https://admin-shell.io/aas/3/1/HasDataSpecification
<https://admin-shell.io/aas/3/1/HasDataSpecification> rdf:type owl:Class .


#################################################################
#    Annotations
#################################################################

:SkillProperty rdfs:comment "Properties of the \"Skill\" SMC" .


