PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex: <http://example.org/>
PREFIX exDef: <http://www.example.org/defInstance/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#> 
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX tool: <http://www.example.org/TwinMap/Tool/> 
PREFIX aasCore: <http://www.example.org/twinMap/AASCore/> 
PREFIX def: <http://www.example.org/defectExample/>

#to be used on the results of tagging connections
SELECT ?defect WHERE
{
  ?defect a exDef:ScrewConnection ; rdf:type/rdfs:subClassOf* def:Defect .
}

