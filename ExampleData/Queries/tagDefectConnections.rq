PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ex: <http://example.org/>
PREFIX exDef: <http://www.example.org/defInstance/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#> 
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX tool: <http://www.example.org/TwinMap/Tool/> 
PREFIX aasCore: <http://www.example.org/twinMap/AASCore/> 
PREFIX def: <http://www.example.org/defectExample/>

INSERT {
  ?faultyConnectionUnder a def:Undertightened .
  ?faultyConnectionOver a def:Overtightened .
} WHERE {
	?faultyConnectionUnder a exDef:ScrewConnection ;
  	exDef:torque ?torqueValueA .
 	FILTER(?torqueValueA <=29) .
  ?faultyConnectionOver a exDef:ScrewConnection ;
  	exDef:torque ?torqueValueB .
 	FILTER(?torqueValueB >=31) .
} 


