#################################################################
#    Individuals
#################################################################

###  http://www.example.com/TwinMap/Tool/FLRight
:FLRight rdf:type owl:NamedIndividual ,
                  :Foglight ;
         :fits :FrontBumper .


###  http://www.example.com/TwinMap/Tool/FrontBumper
:FrontBumper rdf:type owl:NamedIndividual ,
                      :Bumper .


###  http://www.example.com/TwinMap/Tool/HLRight
:HLRight rdf:type owl:NamedIndividual ,
                  :Headlight ;
         :fits :FrontBumper .


###  http://www.example.com/TwinMap/Tool/NutRunner
:NutRunner rdf:type owl:NamedIndividual ,
                    :ScrewDriver ;
           :usedOn :ScrewHL1 ,
                   :ScrewHL2 .


###  http://www.example.com/TwinMap/Tool/ScrewFL1
:ScrewFL1 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL2
:ScrewFL2 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL3
:ScrewFL3 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL4
:ScrewFL4 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewHL1
:ScrewHL1 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :HLRight .


###  http://www.example.com/TwinMap/Tool/ScrewHL2
:ScrewHL2 rdf:type owl:NamedIndividual ,
                   :Screw ;
          :screws :HLRight .


###  http://www.example.com/TwinMap/Tool/W_HL1
:W_HL1 rdf:type owl:NamedIndividual ,
                :LockWasher ;
       :fits :ScrewHL1 .


###  http://www.example.com/TwinMap/Tool/W_HL2
:W_HL2 rdf:type owl:NamedIndividual ,
                :LockWasher ;
       :fits :ScrewHL2 .


