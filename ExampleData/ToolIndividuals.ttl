@prefix toolEx: <http://www.example.org/TwinMap/ToolExample/> .
@prefix tool: <http://www.example.org/TwinMap/Tool/> .
@prefix aasCore: <http://www.example.org/twinMap/AASCore/> .
@prefix aasmm: <https://admin-shell.io/aas/3/2/>.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.example.com/TwinMap/Dummy/> .

#################################################################
#    Individuals
#################################################################

###  http://www.example.com/TwinMap/Tool/FLRight
toolEx:FLRight rdf:type owl:NamedIndividual ,
                  tool:Foglight ;
         tool:fits toolEx:FrontBumper .


###  http://www.example.com/TwinMap/Tool/FrontBumper
toolEx:FrontBumper rdf:type owl:NamedIndividual ,
                      tool:Bumper .


###  http://www.example.com/TwinMap/Tool/HLRight
toolEx:HLRight rdf:type owl:NamedIndividual ,
                  tool:Headlight ;
         tool:fits toolEx:FrontBumper .


###  http://www.example.com/TwinMap/Tool/NutRunner
toolEx:NutRunner rdf:type owl:NamedIndividual ,
                    tool:ScrewDriver ;
           tool:usedOn toolEx:ScrewHL1 ,
                   toolEx:ScrewHL2 .


###  http://www.example.com/TwinMap/Tool/ScrewFL1
toolEx:ScrewFL1 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL2
toolEx:ScrewFL2 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL3
toolEx:ScrewFL3 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewFL4
toolEx:ScrewFL4 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:FLRight .


###  http://www.example.com/TwinMap/Tool/ScrewHL1
toolEx:ScrewHL1 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:HLRight .


###  http://www.example.com/TwinMap/Tool/ScrewHL2
toolEx:ScrewHL2 rdf:type owl:NamedIndividual ,
                   tool:Screw ;
          tool:screws toolEx:HLRight .


###  http://www.example.com/TwinMap/Tool/W_HL1
toolEx:W_HL1 rdf:type owl:NamedIndividual ,
                tool:LockWasher ;
       tool:fits toolEx:ScrewHL1 .


###  http://www.example.com/TwinMap/Tool/W_HL2
toolEx:W_HL2 rdf:type owl:NamedIndividual ,
                tool:LockWasher ;
       tool:fits toolEx:ScrewHL2 .


###  Generated by the OWL API (version 4.5.29.2024-05-13T12:11:03Z) https://github.com/owlcs/owlapi

toolEx:ScrewDriverAAS a aasCore:AASSPecification;
	aasCore:references <https://www.twinmap.de/assets/icb-a-nutrunner/AAS> ;
	aasCore:hasSubmodel toolEx:NutrunnerNameplate .
	
toolEx:NutrunnerNameplate a aasCore:DigitalNameplateForIndustrialEquipment .

toolEx:NutRunner aasCore:modeledIn toolEx:ScrewDriverAAS .

<https://www.twinmap.de/assets/icb-a-nutrunner/AAS> a aasmm:AssetAdministrationShell .